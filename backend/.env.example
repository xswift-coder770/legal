# ==========================================
# LegalMind AI — Backend Environment Variables
# ==========================================

# MongoDB Connection
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# Groq API Key
GROQ_API_KEY=your_groq_api_key_here

# JWT Authentication
JWT_SECRET=your_very_long_random_secret_key_here_at_least_32_chars
JWT_EXPIRES_IN=7d

# Option 1: Chroma Cloud (Official Hosted)
CHROMA_API_KEY=your_chroma_cloud_api_key_here
CHROMA_DATABASE=legal_policy

# Option 2: Local ChromaDB (When running chroma run --port 8000)
CHROMA_URL=http://localhost:8000

# Server Port
PORT=5000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
